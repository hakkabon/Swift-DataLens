{
  "schemaVersion": 1,
  "tolerance": 1e-9,
  "cases": [
    {
      "name": "well-conditioned symmetric",
      "matrix": [[2, 1], [1, 3]],
      "response": [3, 5],
      "expected": [0.8, 1.4],
      "positiveDefinite": true
    },
    {
      "name": "general pivoting",
      "matrix": [[0, 2, 1], [1, -2, -3], [2, 3, 1]],
      "response": [3, -4, 6],
      "expected": [1, 1, 1],
      "positiveDefinite": false
    },
    {
      "name": "singular verdict",
      "matrix": [[1, 2], [2, 4]],
      "response": [1, 2],
      "expected": null,
      "positiveDefinite": false
    }
  ]
}
